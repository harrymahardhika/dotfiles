# runtime-generated
.config/btop/*.conf

# opencode local tooling (node_modules for plugins)
.config/opencode/node_modules/
.config/opencode/bun.lock
.config/opencode/package.json
.config/opencode/package-lock.json
.config/opencode/.gitignore

# neovim per-config lockfiles
nvim-configs/*/lazy-lock.json

# logs / misc runtime
*.log
.nvimlog

# systemd user timers (managed by systemctl, not stow)
.config/systemd/user/timers.target.wants/
