# Migrated from dunst settings in ~/.config/dunst/dunstrc

font=JetBrainsMono Nerd Font 9
markup=1
format=<b>%s</b>\n%b
text-alignment=left

width=380
padding=8
padding=8,16
border-size=1
border-radius=8
max-icon-size=48
icons=1

background-color=#1f1f28
text-color=#dcd7ba
border-color=#8992b2
progress-color=over #16161d

[urgency=low]
default-timeout=5000

[urgency=normal]
default-timeout=8000

[urgency=critical]
default-timeout=0
border-color=#ffa066
