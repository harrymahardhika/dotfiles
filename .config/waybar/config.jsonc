{
  // Prefer waybar-git on Hyprland so workspace clicks keep working.
  "position": "top",
  "modules-left": [
    "custom/power_scheme",
    "battery",
    "backlight",
    "pulseaudio",
    "network",
    "hyprland/submap",
    "custom/keyd_mods"
  ],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": [
    "memory",
    "cpu",
    "custom/cpu_temp",
    "clock#time",
    "clock#date"
  ],
  "hyprland/submap": {
    "format": " {}"
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "format": "{name}"
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 60,
    "separate-outputs": true,
    "rewrite": {
      "tmux(.*)": "tmux",
      "": "(empty)"
    }
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂅 {capacity}%",
    "format-discharging": "{icon} {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-time": "{H}h {M}min",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂"],
    "states": {
      "warning": 30,
      "critical": 15
    },
    "tooltip-format": "{timeTo} ({capacity}%)\nPower: {power}W"
  },
  "clock#time": {
    "format": "󱑆 {:%H:%M}",
    "tooltip": false
  },
  "clock#date": {
    "format": " {:%a %d %b %Y}",
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "on-scroll": 1,
          "format": {
        "months": "<span color='#dcd7ba'><b>{}</b></span>",
        "days": "<span color='#dcd7ba'><b>{}</b></span>",
        "weeks": "<span color='#7aa89f'><b>W{}</b></span>",
        "weekdays": "<span color='#e6c384'><b>{}</b></span>",
        "today": "<span color='#e46876'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 {volume}%",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰄜",
      "portable": "󰄜",
      "car": "󰄋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "tooltip-format": "{desc}\nVolume: {volume}%"
  },
  "cpu": {
    "format": "󰍛 {usage}%",
    "format-alt": "󰍛 Load: {load}",
    "interval": 5,
    "tooltip-format": "CPU: {usage}%\nLoad: {load}"
  },
  "memory": {
    "interval": 5,
    "format": " {used:0.1f}G/{total:0.1f}G ({percentage}%)",
    "format-alt": " {used:0.1f}G/{total:0.1f}G 󰓡 {swapUsed:0.1f}G/{swapTotal:0.1f}G",
    "tooltip-format": "RAM: {used:0.1f}G/{total:0.1f}G ({percentage}%)\nSwap: {swapUsed:0.1f}G/{swapTotal:0.1f}G ({swapPercentage}%)"
  },
  "custom/cpu_temp": {
    "exec": "~/.config/waybar/scripts/cpu-temp.sh",
    "interval": 5,
    "tooltip-format": "CPU Temperature (Package)"
  },
  "custom/keyd_mods": {
    "exec": "~/.config/waybar/scripts/keyd-mods.sh",
    "return-type": "json",
    "tooltip": true
  },
  "custom/power_scheme": {
    "exec": "~/.config/waybar/scripts/power-scheme.sh",
    "return-type": "json",
    "tooltip": true,
    "interval": 30,
    "signal": 8,
    "on-click": "~/scripts/power-pick.sh"
  },
  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 {ifname}",
    "format-alt": "󰖩 {essid} ·  {bandwidthDownBytes}  {bandwidthUpBytes}",
    "format-disconnected": "󰖪 Disconnected",
    "interval": 5,
    "tooltip-format": "{ipaddr}/{cidr}\nGateway: {gwaddr}\nSignal: {signalStrength}%\n󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 80
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip-format": "Brightness: {percent}%"
  }
}
