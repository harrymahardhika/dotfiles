[global]
monitor = 0

alignment = left
corner_radius = 8
font = JetBrainsMono Nerd Font 9
format = "<b>%s</b>\n%b"
frame_color = "#7e9cd8"
frame_width = 1
highlight = "#7e9cd8"
horizontal_padding = 16
icon_position = left
markup = full
max_icon_size = 48
padding = 8
separator_color = frame
transparency = 10
width = (0, 380)
word_wrap = yes

[urgency_low]
background = "#1f1f28"
foreground = "#dcd7ba"
timeout = 5

[urgency_normal]
background = "#1f1f28"
foreground = "#dcd7ba"
timeout = 8

[urgency_critical]
background = "#1f1f28"
foreground = "#dcd7ba"
frame_color = "#ffa066"
timeout = 0

# vim: ft=cfg
